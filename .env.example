# Magnus / Thallo portal configuration.
# Copy to `.env.local` for local Vercel development or configure these in Vercel.
# Never commit real values.

# Server-side portal auth. These are consumed by Vercel API functions, not the
# browser bundle. Production fails closed unless all three are configured.
PORTAL_USERNAME=
PORTAL_PASS_HASH=
PORTAL_SESSION_SECRET=

# Server-side Thallo proxy. The browser calls /api/thallo/* on this deployment;
# the Vercel function calls THALLO_API_BASE with THALLO_PROXY_TOKEN.
THALLO_API_BASE=
THALLO_PROXY_TOKEN=
